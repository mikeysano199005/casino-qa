# ─── Discord ────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
MAIN_GUILD_ID=000000000000000000
ADMIN_GUILD_ID=000000000000000000

# Main server channel IDs (create these channels and paste their IDs)
CH_PLAY=
CH_WALLET=
CH_CHAT=
CH_ACCOUNT=
CH_SUPPORT=

# Admin server channel IDs
CH_ADMIN_PANEL=
CH_WITHDRAW_REQUESTS=
CH_WITHDRAW_HISTORY=
CH_DEPOSIT_LOGS=
CH_PAYMENT_ERRORS=
CH_BET_LOGS=
CH_ROUND_LOGS=
CH_ALERTS=
CH_SUSPICIOUS=
CH_AUDIT_LOG=
CH_BOT_STATUS=

# Comma-separated Discord user IDs allowed to use admin buttons
ADMIN_USER_IDS=

# ─── Postgres / Supabase ─────────────────────────────────────
# Supabase: go to Project Settings → Database → URI (use the "Transaction" pooler)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://user:pass@host:5432/casino

# ─── Cashfree (deposits) ────────────────────────────────────
CASHFREE_ENV=sandbox            # sandbox | prod
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# After deploying to Railway, set this to: https://your-app.railway.app/return
CASHFREE_RETURN_URL=https://your-app.railway.app/return

# ─── Webhook / public URL ───────────────────────────────────
# Railway: set PUBLIC_BASE_URL to the Railway-generated domain, e.g.:
#   https://casino-bot-production.up.railway.app
# PORT is injected automatically by Railway — do not set it manually there.
WEBHOOK_PORT=8787
PUBLIC_BASE_URL=https://your-app.railway.app

# ─── Game economy (rupees; stored as paise internally) ──────
MIN_BET=10
MAX_BET=10000
MIN_DEPOSIT=100
MAX_DEPOSIT=50000
MIN_WITHDRAW=200
WITHDRAW_COOLDOWN_HOURS=24
BIG_WIN_BROADCAST=5000
REFERRAL_BONUS=5000          # paise (₹50 default)

# ─── Anti-fraud ─────────────────────────────────────────────
MAX_BETS_PER_SECOND=4
SAME_IP_ACCOUNT_THRESHOLD=3
