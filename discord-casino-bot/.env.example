# ─── Discord ────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
MAIN_GUILD_ID=000000000000000000
ADMIN_GUILD_ID=000000000000000000

# Comma-separated Discord user IDs allowed to use admin buttons
ADMIN_USER_IDS=

# ─── Player Channels (main server) ──────────────────────────
CH_WALLET=               # deposit / withdraw panel
CH_ACCOUNT=              # profile / daily reward / referrals
CH_SUPPORT=              # support ticket panel
CH_CHAT=                 # big win announcements posted here

# ─── Game Channels ───────────────────────────────────────────
# If a game channel is not set it falls back to CH_PLAY
CH_PLAY=                 # fallback channel for any unset game
CH_MATKA=                # matka king betting panel (live loop)
CH_COLOUR=               # colour prediction panel (live loop)
CH_CRASH=                # crash game panel (live loop)
CH_SLOTS=                # slots panel
CH_DICE=                 # dice panel
CH_BLACKJACK=            # blackjack panel
CH_MINES=                # mines panel

# ─── VIP Channels ────────────────────────────────────────────
CH_MATKA_PREDICTION=     # matka VIP prediction posted each round (prediction preset)

# ─── Admin Channels ──────────────────────────────────────────
CH_ADMIN_PANEL=          # withdrawal approvals + presets + user lookup panel
CH_LIVE_DASHBOARD=       # live stats embed updated every 30s
CH_WITHDRAW_REQUESTS=    # new withdraw requests with approve / reject buttons
CH_WITHDRAW_HISTORY=     # log of approved / rejected withdrawals

# ─── Log Channels ────────────────────────────────────────────
CH_BET_LOGS=             # every individual bet result (high volume)
CH_ROUND_LOGS=           # round summaries — crash / colour / matka
CH_DEPOSIT_LOGS=         # successful deposits
CH_PAYMENT_ERRORS=       # cashfree / payment failures
CH_ALERTS=               # system alerts
CH_SUSPICIOUS=           # suspicious activity flags
CH_AUDIT_LOG=            # mirrors everything — preset changes, approvals, admin actions
CH_BOT_STATUS=           # bot online heartbeat on each restart

# ─── Postgres / Supabase ─────────────────────────────────────
# Supabase: Project Settings → Database → URI (use Transaction pooler)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://user:pass@host:5432/casino

# ─── Cashfree (deposits) ─────────────────────────────────────
CASHFREE_ENV=sandbox             # sandbox | prod
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-app.railway.app

# ─── Webhook ─────────────────────────────────────────────────
# PORT is injected automatically by Railway — do not set it manually there
WEBHOOK_PORT=8787

# ─── Game Economy (rupees; stored as paise internally) ───────
MIN_BET=10
MAX_BET=10000
MIN_DEPOSIT=100
MAX_DEPOSIT=50000
MIN_WITHDRAW=200
WITHDRAW_COOLDOWN_HOURS=24
BIG_WIN_BROADCAST=5000           # paise — wins above this amount broadcast to CH_CHAT
REFERRAL_BONUS=5000              # paise (₹50 default)

# ─── Anti-fraud ──────────────────────────────────────────────
MAX_BETS_PER_SECOND=4
SAME_IP_ACCOUNT_THRESHOLD=3
