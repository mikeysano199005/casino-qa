# ─── Discord ────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
MAIN_GUILD_ID=your_main_guild_id
ADMIN_GUILD_ID=your_admin_guild_id

# Comma-separated Discord user IDs allowed to use admin buttons
ADMIN_USER_IDS=userid1,userid2

# ─── Player Channels (main server) ──────────────────────────
CH_WALLET=channel_id                         # deposit / withdraw panel
CH_ACCOUNT=channel_id                        # profile / daily reward / referrals
CH_SUPPORT=channel_id                        # support ticket panel
CH_CHAT=channel_id                           # big win announcements posted here

# ─── Game Channels ───────────────────────────────────────────
# If a game channel is not set it falls back to CH_PLAY
CH_PLAY=channel_id                           # fallback channel for any unset game
CH_MATKA=channel_id                          # matka king betting panel (live loop)
CH_COLOUR=channel_id                         # colour prediction panel (live loop)
CH_CRASH=channel_id                          # crash game panel (live loop)
CH_SLOTS=channel_id                          # slots panel
CH_DICE=channel_id                           # dice panel
CH_BLACKJACK=channel_id                      # blackjack panel
CH_MINES=channel_id                          # mines panel

# ─── VIP Channels ────────────────────────────────────────────
CH_MATKA_PREDICTION=channel_id               # matka VIP prediction posted each round

# ─── Admin Channels ──────────────────────────────────────────
CH_ADMIN_PANEL=channel_id                    # withdrawal approvals + presets + user lookup panel
CH_LIVE_DASHBOARD=channel_id                 # live stats embed updated every 30s
CH_WITHDRAW_REQUESTS=channel_id              # new withdraw requests with approve / reject buttons
CH_WITHDRAW_HISTORY=channel_id              # log of approved / rejected withdrawals

# ─── Log Channels ────────────────────────────────────────────
CH_BET_LOGS=channel_id                       # every individual bet result (high volume)
CH_ROUND_LOGS=channel_id                     # round summaries — crash / colour / matka
CH_DEPOSIT_LOGS=channel_id                   # successful deposits
CH_PAYMENT_ERRORS=channel_id                 # cashfree / payment failures
CH_ALERTS=channel_id                         # system alerts
CH_SUSPICIOUS=channel_id                     # suspicious activity flags
CH_AUDIT_LOG=channel_id                      # preset changes, approvals, admin actions
CH_BOT_STATUS=channel_id                     # bot online heartbeat on each restart

# ─── Postgres / Supabase ─────────────────────────────────────
# Supabase: Project Settings → Database → URI (use Transaction pooler)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.yourref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# ─── Cashfree (deposits) ─────────────────────────────────────
CASHFREE_ENV=prod
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
CASHFREE_RETURN_URL=https://your-railway-app.up.railway.app/return

# ─── Webhook server (receives Cashfree callbacks) ───────────
WEBHOOK_PORT=8787
PUBLIC_BASE_URL=https://your-railway-app.up.railway.app

# ─── Web Admin Panel ─────────────────────────────────────────
# Served at ${PUBLIC_BASE_URL}/admin — log in with Discord (must be in ADMIN_USER_IDS).
# Create an OAuth app at https://discord.com/developers and add this redirect URI:
#   ${PUBLIC_BASE_URL}/admin/callback
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
ADMIN_SESSION_SECRET=a_long_random_string_for_signing_sessions
# NOTE: all CH_* and economy values below are now optional — the admin panel can
# override any of them at runtime (stored in the `settings` DB table). Env values
# act as the default/fallback when no override is set.

# Web Aviator game (/play) reuses ADMIN_SESSION_SECRET (for the one-tap login
# token) and PUBLIC_BASE_URL (for the link) — no extra variables needed.

# ─── Game Economy (rupees; stored as paise internally) ───────
MIN_BET=10
MAX_BET=10000
MIN_DEPOSIT=100
MAX_DEPOSIT=50000
MIN_WITHDRAW=200
WITHDRAW_COOLDOWN_HOURS=24
BIG_WIN_BROADCAST=5000           # paise — wins above this amount broadcast to CH_CHAT
REFERRAL_BONUS=5000              # paise (₹50 default)

# ─── Anti-fraud ──────────────────────────────────────────────
MAX_BETS_PER_SECOND=4
SAME_IP_ACCOUNT_THRESHOLD=3
